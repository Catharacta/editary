{
  "name": "editary",
  "version": "0.1.37",
  "description": "A Typora-inspired Markdown editor with bold Neo-brutalism aesthetics. High performance built on Electrobun and Bun, featuring Tiptap, Mermaid, and KaTeX.",
  "private": true,
  "dependencies": {
    "@sereneinserenade/tiptap-search-and-replace": "^0.1.1",
    "@tiptap/core": "^3.20.1",
    "@tiptap/extension-bubble-menu": "^3.20.4",
    "@tiptap/extension-character-count": "^3.20.1",
    "@tiptap/extension-code-block": "^3.20.1",
    "@tiptap/extension-horizontal-rule": "^3.20.1",
    "@tiptap/extension-image": "^3.20.1",
    "@tiptap/extension-link": "^3.20.1",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/extension-table": "^3.20.1",
    "@tiptap/extension-table-cell": "^3.20.1",
    "@tiptap/extension-table-header": "^3.20.1",
    "@tiptap/extension-table-row": "^3.20.1",
    "@tiptap/extension-task-item": "^3.20.1",
    "@tiptap/extension-task-list": "^3.20.1",
    "@tiptap/extension-text-align": "^3.20.4",
    "@tiptap/extension-typography": "^3.20.1",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "dompurify": "^3.3.3",
    "electrobun": "latest",
    "katex": "^0.16.38",
    "markdown-it": "^14.1.1",
    "markdown-it-katex": "^2.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.13.0",
    "nativefiledialog-for-bun": "^0.3.2",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/dompurify": "^3.2.0",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^11.0.0",
    "electrobun-builder-for-windows": "^0.3.3",
    "happy-dom": "^20.8.9",
    "rcedit": "^5.0.2",
    "typescript": "^5.0.0",
    "uuid": "^13.0.0"
  },
  "scripts": {
    "start": "electrobun build && electrobun dev",
    "build:dev": "electrobun build",
    "build:stable": "powershell -ExecutionPolicy Bypass -Command \"Import-Module Microsoft.PowerShell.Archive -Force; electrobun build --env=stable\"",
    "builder": "bun node_modules/electrobun-builder-for-windows/dist/index.js",
    "build:installer": "bun run builder -- build --target nsis",
    "build:msi": "bun run builder -- build --target wix",
    "test:builder": "bun run builder -- build --target nsis --dry-run",
    "electrobun:brand": "bun run builder brand"
  }
}
