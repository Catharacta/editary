{
  "name": "editary",
  "version": "0.1.0",
  "description": "A Typora-like Markdown editor with neobrutalism design built on ElectroBun",
  "private": true,
  "dependencies": {
    "@sereneinserenade/tiptap-search-and-replace": "^0.1.1",
    "@tiptap/core": "^3.20.1",
    "@tiptap/extension-character-count": "^3.20.1",
    "@tiptap/extension-code-block": "^3.20.1",
    "@tiptap/extension-horizontal-rule": "^3.20.1",
    "@tiptap/extension-image": "^3.20.1",
    "@tiptap/extension-link": "^3.20.1",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/extension-table": "^3.20.1",
    "@tiptap/extension-table-cell": "^3.20.1",
    "@tiptap/extension-table-header": "^3.20.1",
    "@tiptap/extension-table-row": "^3.20.1",
    "@tiptap/extension-task-item": "^3.20.1",
    "@tiptap/extension-task-list": "^3.20.1",
    "@tiptap/extension-typography": "^3.20.1",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "dompurify": "^3.3.3",
    "electrobun": "latest",
    "katex": "^0.16.38",
    "markdown-it": "^14.1.1",
    "markdown-it-katex": "^2.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.13.0",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/dompurify": "^3.2.0",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "start": "bun run build:dev && electrobun dev",
    "build:dev": "bun install && electrobun build",
    "build:stable": "bun install && electrobun build --env=stable"
